rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /games/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.hostId == request.auth.uid;
      // Every player may advance the game state (e.g. automatic review when the timer ends).
      allow update: if request.auth != null && request.resource.data.hostId == resource.data.hostId;
      allow delete: if request.auth != null && resource.data.hostId == request.auth.uid;

      match /players/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
      match /finds/{findId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && findId.matches(request.auth.uid + '_[0-9]+');
        allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      }
      match /votes/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
